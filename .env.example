# Credenciales de ejemplo. Copia este archivo a .env y rellena tus valores.
# NUNCA subas tu .env real al repositorio.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Amazon Bedrock (usa credenciales AWS estándar / perfil / rol IAM) ---
AWS_REGION=eu-west-1
# AWS_PROFILE=default

# --- Google Vertex AI / Model Garden ---
GOOGLE_PROJECT_ID=my-gcp-project
GOOGLE_LOCATION=us-central1
# Ruta al JSON de la cuenta de servicio
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
